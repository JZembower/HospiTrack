# HospiTrack Environment Variables Configuration
# Copy this file to .env and customize as needed
# NOTE: Never commit .env to version control!

# ============================================
# Application Settings
# ============================================

# Port for the application to listen on
# Default: 8000
PORT=8000

# Python buffering (should be 1 for production logging)
# Default: 1
PYTHONUNBUFFERED=1

# ============================================
# Data Configuration
# ============================================

# Path to hospital data directory
# Default: /app/data (in Docker) or ./data (local)
HOSPITRACK_DATA_PATH=/app/data

# ============================================
# Geocoding Settings
# ============================================

# Size of geocoding cache (LRU cache for address lookups)
# Increase for high-traffic deployments
# Default: 1000
GEOCODING_CACHE_SIZE=1000

# Geocoding rate limit (requests per second)
# Default: 1
GEOCODING_RATE_LIMIT=1

# ============================================
# Feature Flags
# ============================================

# Enable ML-based triage demo
# Set to 'false' to disable ML features
# Default: true
ML_DEMO_ENABLED=true

# ============================================
# Logging Configuration
# ============================================

# Logging level (DEBUG, INFO, WARNING, ERROR, CRITICAL)
# Default: INFO
LOG_LEVEL=INFO

# Enable access logs
# Default: true
ACCESS_LOG_ENABLED=true

# ============================================
# Performance Settings
# ============================================

# Number of Gunicorn workers
# Recommended: (2 x CPU cores) + 1
# Default: 4
GUNICORN_WORKERS=4

# Worker timeout (seconds)
# Default: 120
GUNICORN_TIMEOUT=120

# Keep-alive timeout (seconds)
# Default: 5
GUNICORN_KEEPALIVE=5

# ============================================
# Security Settings (Optional)
# ============================================

# Allowed hosts (comma-separated)
# Example: hospitracker.com,www.hospitracker.com
# ALLOWED_HOSTS=*

# CORS origins (comma-separated)
# Example: https://hospitracker.com,https://www.hospitracker.com
# CORS_ORIGINS=*

# API rate limiting (requests per minute per IP)
# RATE_LIMIT_PER_MINUTE=100

# ============================================
# Monitoring (Optional)
# ============================================

# Enable metrics endpoint
# METRICS_ENABLED=false

# Sentry DSN for error tracking
# SENTRY_DSN=

# ============================================
# Development Settings (Local Only)
# ============================================

# Enable debug mode (NEVER use in production!)
# DEBUG=false

# Enable hot reload
# RELOAD=false
